{
  "entities": {
    "TeacherWorkspace": {
      "title": "TeacherWorkspace",
      "description": "Espace de travail complet synchronisé en temps réel",
      "type": "object",
      "properties": {
        "syncKey": { "type": "string", "maxLength": 64 },
        "teacher": { "type": "object" },
        "classes": { "type": "array" },
        "students": { "type": "array" },
        "assessments": { "type": "array" },
        "grades": { "type": "array" },
        "attendanceSessions": { "type": "array" },
        "attendanceRecords": { "type": "array" },
        "lastUpdated": { "type": "string", "maxLength": 64 },
        "senderDeviceId": { "type": "string", "maxLength": 64 }
      },
      "required": ["syncKey", "lastUpdated", "classes", "students"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceKey}": {
      "schema": { "$ref": "#/entities/TeacherWorkspace" },
      "description": "Données synchronisées entre téléphone et PC pour un enseignant"
    }
  }
}
