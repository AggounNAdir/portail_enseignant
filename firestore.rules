rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidKey(key) {
      return key is string && key.size() >= 4 && key.size() <= 64 && key.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Workspaces synchronisés pour les enseignants (accès protégé par Clé/Code de liaison)
    match /workspaces/{workspaceKey} {
      allow read, write: if isValidKey(workspaceKey);

      match /{allChildren=**} {
        allow read, write: if isValidKey(workspaceKey);
      }
    }
  }
}
